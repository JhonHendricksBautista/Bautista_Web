---
import { timeline } from '@/data/experience';
---

<section id="experience" class="section-shell scroll-mt-24 py-16 md:py-20">
  <div class="grid gap-8 border-t border-line pt-10 md:grid-cols-[10rem_1fr]">
    <h2 class="font-mono text-sm text-muted">Experience</h2>

    <ol class="relative space-y-8 border-l border-line pl-6">
      {
        timeline.map((entry) => (
          <li class="relative">
            <span
              class:list={[
                'absolute -left-[1.6rem] top-1.5 h-2.5 w-2.5 rounded-full border',
                entry.kind === 'Experience'
                  ? 'border-blue bg-blue'
                  : 'border-line-strong bg-surface',
              ]}
              aria-hidden="true"
            />

            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h3 class="text-base font-medium text-ink">{entry.title}</h3>
              <span class="font-mono text-xs text-muted">{entry.period}</span>
            </div>

            <p class="mt-1 text-sm text-muted">{entry.org}</p>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink/80">
              {entry.detail}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
