---
import { projects } from '@/data/projects';
---

<section id="projects" class="section-shell scroll-mt-24 py-16 md:py-20">
  <div class="grid gap-8 border-t border-line pt-10 md:grid-cols-[10rem_1fr]">
    <h2 class="font-mono text-sm text-muted">Projects</h2>

    <ul class="divide-y divide-line">
      {
        projects.map((project) => (
          <li>
            <a
              href={project.href ?? '#'}
              class="group block py-6 first:pt-0"
            >
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="text-lg font-medium text-ink transition-colors group-hover:text-blue">
                  {project.title}
                </h3>
                <span class="font-mono text-xs text-muted">{project.year}</span>
              </div>

              <span
                class="mt-2 block h-px w-0 bg-blue transition-[width] duration-300 ease-out group-hover:w-full"
                aria-hidden="true"
              />

              <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
                {project.summary}
              </p>

              <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-ink/70">
                {project.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
