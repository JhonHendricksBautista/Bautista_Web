---
import { skillGroups } from '@/data/skills';
---

<section id="skills" class="section-shell scroll-mt-24 py-16 md:py-20">
  <div class="grid gap-8 border-t border-line pt-10 md:grid-cols-[10rem_1fr]">
    <h2 class="font-mono text-sm text-muted">Skills</h2>

    <dl class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
      {
        skillGroups.map((group) => (
          <div>
            <dt class="text-sm font-medium text-ink">{group.label}</dt>
            <dd class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-mono text-sm text-muted">
              {group.items.map((item) => (
                <span>{item}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
