---
import Waveform from '@/components/Waveform.astro';
import { site } from '@/data/site';
---

<section class="section-shell pt-20 pb-14 md:pt-28">
  <p class="font-mono text-sm text-muted">{site.role}</p>

  <h1
    class="mt-4 max-w-3xl text-4xl font-semibold leading-[1.1] tracking-tight text-ink md:text-6xl"
  >
    {site.name}
  </h1>

  <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{site.tagline}</p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a
      href="#projects"
      class="rounded bg-blue px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-blue-deep"
    >
      View work
    </a>
    <a
      href={`mailto:${site.email}`}
      class="rounded border border-line px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-blue hover:text-blue"
    >
      Email me
    </a>
  </div>

  <div class="mt-16 md:mt-20">
    <Waveform />
  </div>
</section>
